{
  "title": "hohe-warte – GeoSphere TAWES & Service-Health",
  "uid": "hohe-warte",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "geosphere",
    "hohe-warte"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "station",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(geosphere_observation, station_id)",
        "multi": true,
        "includeAll": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pods up",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=~\".*hohe-warte.*\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Datenalter",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(hohe_warte_last_success_timestamp_seconds)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Upstream-Fehlerquote (1h)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hohe_warte_upstream_requests_total{outcome=\"error\"}[1h])) / sum(rate(hohe_warte_upstream_requests_total[1h]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Upstream-Latenz p95",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hohe_warte_upstream_latency_seconds_bucket[1h])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Lufttemperatur (TL)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geosphere_observation{station_id=~\"$station\",parameter=\"TL\"}",
          "legendFormat": "{{station_id}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Relative Feuchte (RF)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geosphere_observation{station_id=~\"$station\",parameter=\"RF\"}",
          "legendFormat": "{{station_id}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Windgeschwindigkeit (FF)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "velocityms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geosphere_observation{station_id=~\"$station\",parameter=\"FF\"}",
          "legendFormat": "{{station_id}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Luftdruck (P)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pressurehpa"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "geosphere_observation{station_id=~\"$station\",parameter=\"P\"}",
          "legendFormat": "{{station_id}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Container-Speicher",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{container=\"app\",pod=~\".*hohe-warte.*\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Container-CPU",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{container=\"app\",pod=~\".*hohe-warte.*\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}